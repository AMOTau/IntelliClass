PORT=4000
# Local Postgres, or Render External Database URL (add ?sslmode=require).
# Encode special characters in the password (@ becomes %40, # becomes %23).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intliclass
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_KEY=replace-with-one-time-bootstrap-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=school@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="IntelliClass <school@example.com>"

# AI provider: gemini | groq | huggingface | auto
AI_PROVIDER=gemini

# Google Gemini (recommended free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# Optional: Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: Hugging Face (needs prepaid credits)
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

## If your database password contains special characters like @, encode them in the URL.
