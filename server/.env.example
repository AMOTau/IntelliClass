PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intliclass
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_KEY=replace-with-one-time-bootstrap-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=school@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="IntelliClass <school@example.com>"
HUGGINGFACE_TOKEN=replace-with-huggingface-access-token
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Use a token with Inference Providers permission. If a model is unavailable, try adding :cheapest.


## If your database password contains special characters like @, encode them in the URL.